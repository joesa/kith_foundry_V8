#VITE_API_BASE_URL=http://localhost:8000
# Optional override. When unset, WS URL is derived from API URL/current origin.
# VITE_WS_URL=ws://localhost:8000

VITE_USE_NHOST=1
# Must match backend NHOST_AUTH_URL subdomain
VITE_NHOST_SUBDOMAIN=ppekvfshprgndfpisdmn
VITE_NHOST_REGION=us-east-1

# Cloudflare Turnstile — leave blank locally to skip the CAPTCHA widget.
# Set to your actual site key in production / .env.production
VITE_TURNSTILE_SITE_KEY=
