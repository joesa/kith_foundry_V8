FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    curl \
    git \
    nginx \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install fastapi uvicorn

WORKDIR /workspace

# Pre-seed a Vite React template
RUN npm create vite@latest . -- --template react-ts \
    && npm install

# Copy the Kith-branded default files (replaces Vite defaults)
COPY sandbox_defaults/App.tsx /workspace/src/App.tsx
COPY sandbox_defaults/App.css /workspace/src/App.css
COPY sandbox_defaults/main.tsx /workspace/src/main.tsx

# Remove default Vite files we don't need
RUN rm -f /workspace/src/index.css /workspace/src/App.css.bak 2>/dev/null || true

COPY bridge.py /app/bridge.py
COPY start.sh /app/start.sh
COPY nginx.conf /etc/nginx/sites-available/default
RUN chmod +x /app/start.sh

EXPOSE 80

CMD ["/app/start.sh"]
