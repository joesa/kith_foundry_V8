# Fly.io sandbox for Kith Foundry — Vite dev server + bridge API
FROM node:20-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip nginx curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Bridge API (receives file writes from backend)
RUN mkdir -p /app
COPY bridge.py /app/bridge.py
RUN pip3 install --no-cache-dir --break-system-packages fastapi uvicorn

# Vite project scaffold
COPY sandbox_scaffold/package.json /workspace/package.json
COPY sandbox_scaffold/vite.config.ts /workspace/vite.config.ts
COPY sandbox_scaffold/tailwind.config.js /workspace/tailwind.config.js
COPY sandbox_scaffold/postcss.config.js /workspace/postcss.config.js
COPY sandbox_scaffold/tsconfig.json /workspace/tsconfig.json
COPY sandbox_scaffold/index.html /workspace/index.html
COPY sandbox_scaffold/src /workspace/src
COPY sandbox_scaffold/start.sh /app/start.sh
COPY nginx.conf /etc/nginx/sites-available/default

RUN npm install \
    && sed -i 's/\r//' /app/start.sh \
    && chmod +x /app/start.sh \
    && ln -sf /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default

EXPOSE 80
CMD ["/app/start.sh"]
